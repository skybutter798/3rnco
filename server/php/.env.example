# Copy to /home/rncomy/3rnco_shared/.env and set mode 0600.
# Never place the populated file under public_html or commit its secrets.
APP_ENV=production
APP_DEBUG=0
APP_KEY=replace-with-at-least-32-random-characters
APP_ORIGIN=https://3rnco.com.my
PUBLIC_ROOT=/home/rncomy/public_html

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=rncomy_3rnco
DB_USERNAME=rncomy_3rnco
DB_PASSWORD=replace-with-cpanel-database-password

SESSION_COOKIE=rnco_session
SESSION_TTL_SECONDS=43200
GUEST_SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=1

# Exact comma-separated IPs allowed to use the temporary admin password.
BOOTSTRAP_ADMIN_IPS=replace-with-deployer-public-ip

# Pending manual-payment orders reserve inventory for this many minutes.
ORDER_RESERVATION_MINUTES=1440

# Keep uploaded files in shared storage and expose it through public_html/uploads.
UPLOAD_DIR=/home/rncomy/3rnco_shared/uploads
UPLOAD_PUBLIC_BASE=/uploads
UPLOAD_MAX_BYTES=7864320
PAYMENT_RECEIPT_DIR=/home/rncomy/3rnco_shared/payment-receipts
PAYMENT_RECEIPT_MAX_BYTES=8388608

# Backups must remain outside public_html.
BACKUP_DIR=/home/rncomy/backups/3rnco
BACKUP_UPLOAD_DIR=/home/rncomy/3rnco_shared/uploads
MYSQLDUMP_BINARY=/usr/bin/mysqldump
TAR_BINARY=/usr/bin/tar
